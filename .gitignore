# ── Frontend (eventora-frontend/) ────────────────────────────────────────────
eventora-frontend/node_modules
eventora-frontend/.next/
eventora-frontend/out/
eventora-frontend/build
eventora-frontend/.env*
eventora-frontend/.vercel
eventora-frontend/*.tsbuildinfo
eventora-frontend/next-env.d.ts

# ── Stray root-level Next.js artifacts (from accidental root installs) ────────
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# ── Backend (eventora-backend/) ──────────────────────────────────────────────
eventora-backend/**/bin/
eventora-backend/**/obj/

# ── Debug logs ───────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Misc (env files, OS artifacts) ───────────────────────────────────────────
.env*
.DS_Store
Thumbs.db

# Local dev secrets (never commit)
appsettings.Development.json
eventora-frontend/.env.local
